# OrangeHRM demo credentials (https://opensource-demo.orangehrmlive.com)
# Why ORANGEHRM_* names: on Windows, USERNAME is already set to your PC login;
# using USERNAME here would be ignored or wrong when load_dotenv does not override OS vars.
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# Optional: Bearer token for REST API v2 tests (TestAPI/). Without it, those tests skip.
# ORANGEHRM_API_TOKEN=
